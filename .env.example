# ============================================================
# YakuAlert Qollana - Variables de entorno
# ============================================================
# Instrucciones:
# 1. En https://supabase.com crea un proyecto nuevo (nombre sugerido: yakualert-qollana).
# 2. Ve a Project Settings > API y copia los valores de abajo.
# 3. Copia este archivo como `.env` (en la RAIZ del proyecto) y pega tus valores.
# 4. Aplica la migración supabase/migrations/20261020_init_schema.sql
#    desde el SQL Editor de Supabase (o con `supabase db push`).
# ============================================================

# URL del proyecto Supabase (aparece en Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública anon (segura para el navegador; protégela con RLS)
VITE_SUPABASE_ANON_KEY=TA_CLAVE_ANON_AQUI

# Coordenadas del centro de la comunidad Qollana (usadas por defecto en el mapa)
VITE_LAT_CENTRO=-16.5
VITE_LNG_CENTRO=-68.15
